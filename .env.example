# Kopieer naar .env.local en vul in. Commit .env.local NOOIT.

# Merknaam; wordt overal in de site en app gebruikt (logo-woordmerk splitst "…Planner" in ivoor en goud).
NEXT_PUBLIC_BRAND_NAME=LucxePlanner

# Publieke basis-URL van de site (gebruikt voor sitemap, e-maillinks en canonieke URL's).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase-project (Project Settings → API). De anon/publishable key is bedoeld voor de browser;
# toegang wordt afgedwongen met Row Level Security in de database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Contactadres dat op de contactpagina en in juridische teksten wordt getoond.
NEXT_PUBLIC_CONTACT_EMAIL=info@example.com
