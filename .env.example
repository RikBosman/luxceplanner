# Kopieer naar .env.local en vul in. Commit .env.local NOOIT.

# Merknaam; wordt overal in de site en app gebruikt (logo-woordmerk splitst "…Planner" in ivoor en goud).
NEXT_PUBLIC_BRAND_NAME=LucxePlanner

# Publieke basis-URL van de site (gebruikt voor sitemap, e-maillinks en canonieke URL's).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase-project (Project Settings → API). De anon/publishable key is bedoeld voor de browser;
# toegang wordt afgedwongen met Row Level Security in de database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Contactadres dat op de contactpagina en in juridische teksten wordt getoond.
NEXT_PUBLIC_CONTACT_EMAIL=info@example.com

# AI-render (foto-echte impressie van de 3D-weergave via Google Gemini). Alleen op de server; nooit NEXT_PUBLIC_.
# Sleutel aanmaken: https://aistudio.google.com/apikey (gebruik voor productie het betaalde niveau, zie README).
GEMINI_API_KEY=
# Optioneel: ander beeldmodel, bijv. een nieuwere "Nano Banana"-versie.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Maximaal aantal AI-renders per gebruiker per dag (kostenbewaking).
AI_RENDER_DAILY_LIMIT=20
# "mock" = testmodus zonder AI (alleen lokaal/ontwikkeling), "off" = uitzetten.
AI_RENDER_PROVIDER=
